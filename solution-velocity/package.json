{
  "name": "solution-velocity",
  "private": true,
  "version": "1.0.0",
  "description": "Solution Velocity — Journey-first Product Development Lifecycle Management platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @sv/api run dev",
    "dev:web": "npm --workspace @sv/web run dev",
    "build": "npm --workspace @sv/web run build",
    "start": "npm --workspace @sv/api run start",
    "typecheck": "npm --workspace @sv/api run typecheck && npm --workspace @sv/web run typecheck",
    "test": "vitest run",
    "db:seed": "npm --workspace @sv/api run seed"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "concurrently": "^9.2.1",
    "jsdom": "^31.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
