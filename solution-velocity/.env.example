# --- Database -------------------------------------------------------------
# Production requires a real PostgreSQL connection string.
# Development falls back to an embedded Postgres (PGlite) stored in .data/pg,
# so no database server is needed locally.
# DATABASE_URL=postgres://user:password@host:5432/solution_velocity

# --- API ------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
# Where the embedded development database lives.
# SV_DATA_DIR=./.data/pg
# Set to 1 to start with an empty workspace instead of the demo organisation.
# SV_SKIP_SEED=1

# --- Optional hosted assistant -------------------------------------------
# When unset, the assistant answers deterministically from the project's own
# records. Set these to route the same project-scoped context to a hosted model.
# SV_ASSISTANT_ENDPOINT=https://api.openai.com/v1/chat/completions
# SV_ASSISTANT_API_KEY=
# SV_ASSISTANT_MODEL=gpt-4o-mini

# --- Web ------------------------------------------------------------------
# Extra origins allowed to call the API (development only; same-origin in production).
# SV_WEB_ORIGIN=https://your-preview-host
